{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input_video.mp4",
      "force_rate": 0,
      "force_size": "Custom",
      "custom_width": 1920,
      "custom_height": 1080,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "AnimateDiff",
      "unique_id": 0
    }
  },
  "2": {
    "class_type": "RIFE VFI",
    "inputs": {
      "ckpt_name": "rife47.pth",
      "clear_cache_after_n_frames": 10,
      "multiplier": 2,
      "fast_mode": true,
      "ensemble": true,
      "scale_factor": 1,
      "frames": ["1", 0]
    }
  },
  "3": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "frame_rate": 30,
      "loop_count": 0,
      "filename_prefix": "rife_out/video",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "images": ["2", 0]
    }
  }
}
