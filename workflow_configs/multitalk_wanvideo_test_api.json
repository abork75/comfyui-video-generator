{
  "1": {
    "inputs": {
      "blocks_to_swap": 20,
      "offload_img_emb": false,
      "offload_txt_emb": false,
      "use_non_blocking": true,
      "vace_blocks_to_swap": 0,
      "prefetch_blocks": 1,
      "block_swap_debug": false
    },
    "class_type": "WanVideoBlockSwap",
    "_meta": {"title": "[LOADER] Block Swap (VRAM)"}
  },
  "2": {
    "inputs": {
      "model": "wan2.1-i2v-14b-480p-Q4_0.gguf",
      "base_precision": "fp16_fast",
      "quantization": "disabled",
      "load_device": "offload_device",
      "attention_mode": "sdpa",
      "rms_norm_function": "default",
      "block_swap_args": ["1", 0],
      "lora": ["3", 0],
      "multitalk_model": ["4", 0]
    },
    "class_type": "WanVideoModelLoader",
    "_meta": {"title": "[LOADER] WAN 2.1 Base Model"}
  },
  "3": {
    "inputs": {
      "lora": "lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors",
      "strength": 1,
      "low_mem_load": false,
      "merge_loras": false
    },
    "class_type": "WanVideoLoraSelect",
    "_meta": {"title": "[LOADER] LoRA lightx2v"}
  },
  "4": {
    "inputs": {
      "model": "Wan2_1-InfiniteTalk_Single_Q8.gguf"
    },
    "class_type": "MultiTalkModelLoader",
    "_meta": {"title": "[LOADER] InfiniteTalk Model"}
  },
  "5": {
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    },
    "class_type": "CLIPVisionLoader",
    "_meta": {"title": "[LOADER] CLIP Vision"}
  },
  "6": {
    "inputs": {
      "model_name": "wan_2.1_vae.safetensors",
      "precision": "bf16",
      "use_cpu_cache": false,
      "verbose": false
    },
    "class_type": "WanVideoVAELoader",
    "_meta": {"title": "[LOADER] VAE"}
  },
  "7": {
    "inputs": {
      "model": "wav2vec2-chinese-base_fp16.safetensors",
      "base_precision": "fp16",
      "load_device": "main_device"
    },
    "class_type": "Wav2VecModelLoader",
    "_meta": {"title": "[LOADER] Wav2Vec2"}
  },

  "10": {
    "inputs": {"image": "placeholder_mask1.png"},
    "class_type": "LoadImage",
    "_meta": {"title": "[PATCH] Image + Maska Osoba 1 (namalowana)"}
  },
  "11": {
    "inputs": {"image": "placeholder_mask2.png"},
    "class_type": "LoadImage",
    "_meta": {"title": "[PATCH] Ten sam obraz + Maska Osoba 2 (namalowana)"}
  },
  "12": {
    "inputs": {"audio": "speaker1.mp3", "audioUI": ""},
    "class_type": "LoadAudio",
    "_meta": {"title": "[PATCH] Audio - Osoba 1 (mowi)"}
  },
  "13": {
    "inputs": {"audio": "silence0.5s.mp3", "audioUI": ""},
    "class_type": "LoadAudio",
    "_meta": {"title": "[PATCH] Audio - Osoba 2 (cisza lub mowi)"}
  },

  "20": {
    "inputs": {
      "upscale_method": "lanczos",
      "width": 480,
      "height": 832,
      "crop": "disabled",
      "image": ["10", 0]
    },
    "class_type": "ImageScale",
    "_meta": {"title": "[PATCH] Resize obrazu (width/height podmieniane przez backend)"}
  },
  "21": {
    "inputs": {"image": ["20", 0]},
    "class_type": "GetImageSize",
    "_meta": {"title": "Pobierz wymiary"}
  },

  "31": {
    "inputs": {"mask": ["10", 1]},
    "class_type": "MaskToImage",
    "_meta": {"title": "Maska1 -> Image"}
  },
  "32": {
    "inputs": {
      "upscale_method": "lanczos",
      "width": ["21", 0],
      "height": ["21", 1],
      "crop": "disabled",
      "image": ["31", 0]
    },
    "class_type": "ImageScale",
    "_meta": {"title": "Resize Maska1"}
  },
  "33": {
    "inputs": {"image": ["32", 0], "channel": "red"},
    "class_type": "ImageToMask",
    "_meta": {"title": "Image -> Maska1"}
  },

  "34": {
    "inputs": {"mask": ["11", 1]},
    "class_type": "MaskToImage",
    "_meta": {"title": "Maska2 -> Image"}
  },
  "35": {
    "inputs": {
      "upscale_method": "lanczos",
      "width": ["21", 0],
      "height": ["21", 1],
      "crop": "disabled",
      "image": ["34", 0]
    },
    "class_type": "ImageScale",
    "_meta": {"title": "Resize Maska2"}
  },
  "36": {
    "inputs": {"image": ["35", 0], "channel": "red"},
    "class_type": "ImageToMask",
    "_meta": {"title": "Image -> Maska2"}
  },

  "22": {
    "inputs": {
      "strength_1": 1,
      "strength_2": 1,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true,
      "tiles": 0,
      "ratio": 0.5,
      "clip_vision": ["5", 0],
      "image_1": ["20", 0]
    },
    "class_type": "WanVideoClipVisionEncode",
    "_meta": {"title": "CLIP Vision Encode"}
  },
  "23": {
    "inputs": {
      "width": ["21", 0],
      "height": ["21", 1],
      "frame_window_size": 81,
      "motion_frame": 25,
      "force_offload": false,
      "colormatch": "disabled",
      "tiled_vae": false,
      "mode": "infinitetalk",
      "output_path": "",
      "vae": ["6", 0],
      "start_image": ["20", 0],
      "clip_embeds": ["22", 0]
    },
    "class_type": "WanVideoImageToVideoMultiTalk",
    "_meta": {"title": "MultiTalk Image2Video"}
  },
  "37": {
    "inputs": {
      "mask1": ["33", 0],
      "mask2": ["36", 0]
    },
    "class_type": "MaskBatch+",
    "_meta": {"title": "Batch Masek (osoba1 + osoba2)"}
  },
  "24": {
    "inputs": {
      "model_name": "umt5-xxl-enc-bf16.safetensors",
      "precision": "bf16",
      "positive_prompt": "Two people talking naturally",
      "negative_prompt": "bright tones, overexposed, static, blurred details, subtitles, worst quality, low quality, JPEG compression residue, ugly, incomplete, deformed, disfigured, still picture",
      "quantization": "disabled",
      "use_disk_cache": false,
      "device": "gpu"
    },
    "class_type": "WanVideoTextEncodeCached",
    "_meta": {"title": "Text Encode"}
  },
  "27": {
    "inputs": {
      "normalize_loudness": true,
      "num_frames": 1000,
      "fps": 25,
      "audio_scale": 1,
      "audio_cfg_scale": 1,
      "multi_audio_type": "para",
      "add_noise_floor": false,
      "smooth_transients": false,
      "wav2vec_model": ["7", 0],
      "audio_1": ["12", 0],
      "audio_2": ["13", 0],
      "ref_target_masks": ["37", 0]
    },
    "class_type": "MultiTalkWav2VecEmbeds",
    "_meta": {"title": "Wav2Vec Audio Embeds + Maski twarzy"}
  },
  "28": {
    "inputs": {
      "steps": 6,
      "cfg": 1.0,
      "shift": 11.0,
      "seed": 42,
      "control_after_generate": "randomize",
      "force_offload": true,
      "scheduler": "dpm++_sde",
      "riflex_freq_index": 0,
      "denoise_strength": 1,
      "batched_cfg": false,
      "rope_function": "comfy",
      "start_step": 0,
      "end_step": -1,
      "add_noise_to_samples": true,
      "model": ["2", 0],
      "image_embeds": ["23", 0],
      "text_embeds": ["24", 0],
      "multitalk_embeds": ["27", 0]
    },
    "class_type": "WanVideoSampler",
    "_meta": {"title": "Sampler (6 steps, dpm++_sde)"}
  },
  "29": {
    "inputs": {
      "enable_vae_tiling": false,
      "tile_x": 272,
      "tile_y": 272,
      "tile_stride_x": 144,
      "tile_stride_y": 128,
      "normalization": "default",
      "vae": ["6", 0],
      "samples": ["28", 0]
    },
    "class_type": "WanVideoDecode",
    "_meta": {"title": "VAE Decode"}
  },

  "40": {
    "inputs": {
      "direction": "after",
      "audio1": ["12", 0],
      "audio2": ["13", 0]
    },
    "class_type": "AudioConcat",
    "_meta": {"title": "Concat Audio (speaker1 + speaker2)"}
  },
  "41": {
    "inputs": {
      "frame_rate": 25,
      "loop_count": 0,
      "filename_prefix": "video/multitalk_wanvideo",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": true,
      "pingpong": false,
      "save_output": true,
      "images": ["29", 0],
      "audio": ["40", 0]
    },
    "class_type": "VHS_VideoCombine",
    "_meta": {"title": "Save Video"}
  }
}
