    "_meta": { "title": "Fade Blend  (klatki 1-76 → fade, 77+ oryginał)" }
  },
  "5": {
    "inputs": {
      "images": ["4", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "idzie_do_przedpokoju_mklfade",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true,
      "audio": ["1", 2]
    },
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Save Video z fade korekcją" }
  }
}
