{
  "1": {
    "inputs": {
      "video": "idzie do przedpokoju_001.mp4",
      "force_rate": 16,
      "force_uniform_fps": true,
      "force_size": "Disabled",
      "custom_width": 880,
      "custom_height": 1184,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    },
    "class_type": "VHS_LoadVideo",
    "_meta": { "title": "Load Video — oryginał (wszystkie klatki)" }
  },
  "2": {
    "inputs": {
      "image": "12.51. siedzi na pilce 2.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
